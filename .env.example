# Application Environment Variables
# Firebase Web Configuration (Optional for Cloud persistence, app runs local-first with full offline/cloud fallback)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Application Host URL (e.g., https://yourdomain.vercel.app)
VITE_APP_URL="https://yourdomain.vercel.app"
